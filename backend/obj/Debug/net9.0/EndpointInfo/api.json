          "ask",
          "bid",
          "code",
          "currency"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "bid": {
            "type": "number",
            "format": "double"
